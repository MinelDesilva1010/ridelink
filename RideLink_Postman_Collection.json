{
  "info": {
    "name": "RideLink Microservices",
    "description": "Postman collection for testing the RideLink backend microservices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "name": "Driver Service (8082)",
  "item": [
    {
      "name": "Register Driver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": 1,\n  \"name\": \"Alice\",\n  \"status\": \"AVAILABLE\",\n  \"currentLocation\": \"Colombo\",\n  \"serviceArea\": \"Downtown\",\n  \"vehicle\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Prius\",\n    \"licensePlate\": \"CBE-1234\",\n    \"capacity\": 4\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:8082/api/drivers",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8082",
          "path": [
            "api",
            "drivers"
          ]
        }
      }
    },
    {
      "name": "Get Available Drivers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8082/api/drivers/available?serviceArea=Downtown",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8082",
          "path": [
            "api",
            "drivers",
            "available"
          ],
          "query": [
            {
              "key": "serviceArea",
              "value": "Downtown"
            }
          ]
        }
      }
    }
  ]
}